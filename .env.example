# ===== Bulk LLM (high-volume: entity extraction, ontology, simulation loop) =====
# Runs locally via Ollama — free, unlimited, no per-token bill.
#   ollama serve && ollama pull qwen2.5:14b
# NOTE: the key is ignored by Ollama but must be NON-EMPTY (an empty key errors).
LLM_API_KEY=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL_NAME=qwen2.5:14b

# ===== Neo4j Graph Database Configuration =====
# Start Neo4j with Docker Compose: docker-compose up -d
# Neo4j Browser: http://localhost:7474
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=pubop123
NEO4J_DATABASE=neo4j

# ===== Boost LLM (low-volume, quality-sensitive: report agent, persona synthesis) =====
# Standard OpenAI API (or any OpenAI-compatible endpoint). Cheap at this volume.
# Set ALL THREE or it silently falls back to the bulk (local) slot above and your
# "quality" calls run on the local model too.
LLM_BOOST_API_KEY=your_openai_api_key_here
LLM_BOOST_BASE_URL=https://api.openai.com/v1
LLM_BOOST_MODEL_NAME=gpt-4o

# ===== Web Search (Tavily) =====
# Powers the report agent's web_search tool. Leave blank to disable web search.
# Get a key at https://tavily.com (free tier ~1k searches/mo).
TAVILY_API_KEY=

# ===== OASIS Simulation Configuration =====
OASIS_DEFAULT_MAX_ROUNDS=10

# ===== Report Agent Configuration =====
REPORT_AGENT_MAX_TOOL_CALLS=5
REPORT_AGENT_MAX_REFLECTION_ROUNDS=2
REPORT_AGENT_TEMPERATURE=0.5

# ===== API Timeout Configuration (in seconds) =====
PANEL_CHAT_TIMEOUT=180
SURVEY_DEPLOY_TIMEOUT=180
INTERVIEW_BATCH_TIMEOUT=120
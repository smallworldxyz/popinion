# LLM API Configuration (supports any LLM with OpenAI SDK format)
# Recommended: Use a capable model like GPT-4, Claude, or Qwen
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini

# ===== Neo4j Graph Database Configuration =====
# Start Neo4j with Docker Compose: docker-compose up -d
# Neo4j Browser: http://localhost:7474
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=pubop123
NEO4J_DATABASE=neo4j

# ===== Optional: Boost LLM Configuration =====
# Use a faster/cheaper model for less critical tasks
LLM_BOOST_API_KEY=your_boost_api_key_here
LLM_BOOST_BASE_URL=https://api.openai.com/v1
LLM_BOOST_MODEL_NAME=gpt-4o-mini

# ===== OASIS Simulation Configuration =====
OASIS_DEFAULT_MAX_ROUNDS=10

# ===== Report Agent Configuration =====
REPORT_AGENT_MAX_TOOL_CALLS=5
REPORT_AGENT_MAX_REFLECTION_ROUNDS=2
REPORT_AGENT_TEMPERATURE=0.5

# ===== API Timeout Configuration (in seconds) =====
PANEL_CHAT_TIMEOUT=180
SURVEY_DEPLOY_TIMEOUT=180
INTERVIEW_BATCH_TIMEOUT=120
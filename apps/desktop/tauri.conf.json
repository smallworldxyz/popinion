{
  "$schema": "../web/node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Popinion",
  "version": "0.3.0",
  "identifier": "ai.popinion.desktop",
  "build": {
    "frontendDist": "../web/dist",
    "devUrl": "http://localhost:3100"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
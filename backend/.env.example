# =============================================================================
# pubop Backend Environment Configuration
# =============================================================================
# Copy this file to .env and update with your values

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=pubop123

# -----------------------------------------------------------------------------
# LLM Configuration
# -----------------------------------------------------------------------------
# OpenAI-compatible API endpoint
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4

# -----------------------------------------------------------------------------
# Crawler Configuration
# -----------------------------------------------------------------------------
# CDP endpoint for headless browser (Browserless Chrome)
CRAWLER_CDP_ENDPOINT=http://localhost:9222

# Proxy configuration (optional, for anti-bot protection)
# Single proxy server
# CRAWLER_PROXY_SERVER=http://proxy.example.com:8080

# Proxy authentication (optional)
# CRAWLER_PROXY_USERNAME=
# CRAWLER_PROXY_PASSWORD=

# Proxy rotation pool (comma-separated list)
# CRAWLER_PROXY_POOL=http://proxy1:8080,http://proxy2:8080,http://proxy3:8080

# -----------------------------------------------------------------------------
# Platform API Keys (optional, for official API access)
# -----------------------------------------------------------------------------
# Telegram Bot API (for accessing private channels)
# TELEGRAM_BOT_TOKEN=

# Twitter/X API v2
# TWITTER_BEARER_TOKEN=
# TWITTER_API_KEY=
# TWITTER_API_SECRET=

# Facebook/Meta Graph API
# FACEBOOK_ACCESS_TOKEN=
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
# Flask settings
FLASK_ENV=development
FLASK_DEBUG=1

# Data directories
DATA_DIR=./data
UPLOAD_FOLDER=./uploads

# -----------------------------------------------------------------------------
# OASIS Simulation Configuration (optional)
# -----------------------------------------------------------------------------
# OASIS_API_URL=http://localhost:8000
# OASIS_REDDIT_URL=http://localhost:8001
# OASIS_TWITTER_URL=http://localhost:8002

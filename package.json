{
  "name": "pubop",
  "version": "0.3.0",
  "description": "pubop - Global Public Opinion Analysis Platform powered by AI Simulation",
  "scripts": {
    "setup": "bun install && cd frontend && bun install",
    "setup:backend": "cd backend-rs && cargo build",
    "setup:all": "bun run setup && bun run setup:backend",
    "dev": "concurrently -n \"backend,frontend\" -c \"yellow,cyan\" \"bun run backend\" \"bun run frontend\"",
    "preview": "concurrently -n \"backend,frontend\" -c \"yellow,cyan\" \"bun run backend\" \"bun run frontend:preview\"",
    "backend": "cd backend-rs && cargo run",
    "frontend": "cd frontend && bun run dev",
    "frontend:preview": "cd frontend && bun run preview -- --host",
    "build": "cd frontend && bun run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}